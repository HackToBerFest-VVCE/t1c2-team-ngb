# Local mode is always explicitly identified as DEMO. Switch to snowflake only
# after configuring and verifying the target table described in snowflake/setup.md.
DATA_SOURCE=demo
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Set one authentication method. For Vercel, use the sensitive server-side
# SNOWFLAKE_PRIVATE_KEY_BASE64 variable with a base64-encoded PEM key.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_BASE64=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=THREATLENS
SNOWFLAKE_ROLE=
SNOWFLAKE_TABLE=VULNERABILITIES
SNOWFLAKE_MAX_ROWS=500000
# Optional Cortex Complete model (default is a currently supported small model).
SNOWFLAKE_CORTEX_MODEL=llama3.1-8b
# Optional separate append-only audit writer identity. Grant SELECT, INSERT only.
SNOWFLAKE_AUDIT_ACCOUNT=
SNOWFLAKE_AUDIT_USER=
SNOWFLAKE_AUDIT_WAREHOUSE=
SNOWFLAKE_AUDIT_DATABASE=
SNOWFLAKE_AUDIT_SCHEMA=THREATLENS
SNOWFLAKE_AUDIT_TABLE=THREATLENS_AUDIT_EVENTS
SNOWFLAKE_AUDIT_ROLE=
SNOWFLAKE_AUDIT_PASSWORD=
SNOWFLAKE_AUDIT_PRIVATE_KEY_PATH=
SNOWFLAKE_AUDIT_PRIVATE_KEY_BASE64=
SNOWFLAKE_AUDIT_PRIVATE_KEY_PASSPHRASE=
THREATLENS_AUDIT_WRITE_TOKEN=
# Optional AI analysis; each provider uses its own API key and endpoint.
# Keys stay on the Flask server. Set the key matching the selected provider.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
FRONTEND_ORIGINS=http://localhost:5173
API_PORT=5000
FLASK_DEBUG=false
