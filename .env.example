# Local mode is always explicitly identified as DEMO. Switch to snowflake only
# after configuring and verifying the target table described in snowflake/setup.md.
DATA_SOURCE=demo
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=THREATLENS
SNOWFLAKE_ROLE=
SNOWFLAKE_TABLE=VULNERABILITIES
SNOWFLAKE_MAX_ROWS=500000
# Optional AI analysis through NVIDIA NIM (keys stay on the Flask server).
# Choose one provider; put a newly rotated NIM token in its matching variable.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
FRONTEND_ORIGINS=http://localhost:5173
API_PORT=5000
FLASK_DEBUG=false
