{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build && node scripts/copy-frontend.mjs",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env,.env.*,**/.env,**/.env.*,**/tests/**,**/*.test.*,**/node_modules/**,**/.venv/**,data/external/**,data/vulnerabilities.full.json,data/vulnerabilities.full.json.gz}"
    }
  }
}
