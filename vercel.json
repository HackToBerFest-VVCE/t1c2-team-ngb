{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "other",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build && node scripts/copy-frontend.mjs",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?match="
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?match=:match*"
    },
    {
      "source": "/((?!assets/|favicon.ico|api).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,data/**}",
      "excludeFiles": "{.env,.env.*,**/.env,**/.env.*,**/tests/**,**/*.test.*,**/node_modules/**,**/.venv/**,data/external/**,data/vulnerabilities.full.json,data/vulnerabilities.full.json.gz,data/vulnerabilities.full.parquet}"
    }
  }
}
